---
import { NAP } from '../../lib/nap';
const BASE_ING = '/academia-de-ingles-en-sevilla-este';

const cols = [
  {
    t: 'Estudios',
    icono: 'libro',
    links: [
      ['Clases de apoyo', '/clases-de-apoyo/'],
      ['Clases particulares', '/clases-particulares-sevilla/'],
      ['Cursos de verano', '/cursos-verano-sevilla/'],
      ['Cursos de invierno', '/cursos-de-invierno/'],
    ],
  },
  {
    t: 'Pruebas de acceso',
    icono: 'diploma',
    links: [
      ['Selectividad PEvAU', '/curso-selectividad-sevilla-pevau/'],
      ['Intensivos PEvAU', '/curso-intensivos-selectividad-pevau/'],
      ['Grado Superior', '/prueba-acceso-grado-superior-sevilla/'],
      ['Grado Medio', '/acceso-grado-medio-academia-sevilla/'],
      ['Mayores de 25 y 45', '/acceso-universidad-mayores-25/'],
      ['Título de ESO', '/conseguir-titulo-eso/'],
      ['Fechas y convocatorias', '/fechas-y-convocatorias/'],
    ],
  },
  {
    t: 'Inglés',
    icono: 'globo',
    links: [
      ['Niños', `${BASE_ING}/ninos/`],
      ['Teens', `${BASE_ING}/teens/`],
      ['Adultos', `${BASE_ING}/adultos/`],
      ['Trinity', `${BASE_ING}/trinity/`],
      ['Cambridge', `${BASE_ING}/cambridge/`],
      ['APTIS', `${BASE_ING}/aptis/`],
      ['B1 · B2 · C1', `${BASE_ING}/b1/`],
      ['Intensivos', `${BASE_ING}/intensivos/`],
    ],
  },
  {
    t: 'Academia',
    icono: 'academia',
    links: [
      ['Quiénes somos', '/quienes-somos-academia-educana/'],
      ['Horarios y precios', '/horarios-cursos/'],
      ['Noticias', '/noticias-academia-educana/'],
      ['Trabaja con nosotros', '/bolsa-de-trabajo-academia-sevilla/'],
      ['Contacto', '/contacto/'],
    ],
  },
];

/* Un icono lineal por sección — coherente con el resto del sitio,
   nunca emoji ni glifos de color (doc 04). */
const iconos: Record<string, string> = {
  libro: 'M4 5.5c0-1 1-1.5 2-1.5h5.5v13H6c-1 0-2 .5-2 1.5V5.5Z M19.5 19.5H13.5V6.5C13.5 5.5 14.5 5 15.5 5H19.5v14.5Z',
  diploma: 'M8 3h8v9l-4 2.5L8 12V3Z M6 21l3-6 3 2 3-2 3 6',
  globo: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M3.5 12h17 M12 3c2.5 2.4 3.8 5.6 3.8 9s-1.3 6.6-3.8 9c-2.5-2.4-3.8-5.6-3.8-9s1.3-6.6 3.8-9Z',
  academia: 'M12 4 2 9l10 5 8-4.2V15 M6 11.3V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.7',
};
---
<footer class="bg-blue text-cream/70 print:hidden">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1fr_1fr_1fr_1fr_1.1fr]">
    {cols.map((c) => (
      <div>
        <h2 class="mb-4 flex items-center gap-2 font-body text-[0.72rem] font-bold uppercase tracking-[0.14em] text-cream">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0 text-amber">
            <path d={iconos[c.icono]} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {c.t}
        </h2>
        <ul class="flex flex-col gap-2 text-[0.92rem]">
          {c.links.map(([l, h]) => (
            <li>
              <a href={h} class="group flex items-center gap-1.5 hover:text-cream transition-colors">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0 -ml-0.5 opacity-50 transition-transform group-hover:translate-x-0.5 group-hover:opacity-100">
                  <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {l}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="flex flex-col gap-4 md:col-span-4 lg:col-span-1">
      <img src="/logo-educana-oscuro.png" alt="Academia Educana" width="350" height="157" class="h-12 w-auto self-start" />
      <address class="not-italic text-[0.9rem] leading-relaxed">
        {NAP.street}<br />{NAP.postal} {NAP.city}<br />
        <a href="tel:+34954409696" class="hover:text-cream tabular">954 40 96 96</a> ·
        <a href="tel:+34686085566" class="hover:text-cream tabular">686 08 55 66</a><br />
        <a href={`mailto:${NAP.email}`} class="hover:text-cream">{NAP.email}</a>
      </address>
    </div>
  </div>
  <div class="border-t border-cream/12">
    <div class="container-page flex flex-wrap gap-x-6 gap-y-2 py-5 text-[0.85rem]">
      <span>© {new Date().getFullYear()} Academia Educana</span>
      <a href="/aviso-legal/" class="hover:text-cream">Aviso legal</a>
      <a href="/politica-de-privacidad/" class="hover:text-cream">Privacidad</a>
      <a href="/politica-de-cookies/" class="hover:text-cream">Cookies</a>
      <a href="/noticias-academia-educana/" class="ml-auto hover:text-cream">Noticias</a>
      <a href="/bolsa-de-trabajo-academia-sevilla/" class="hover:text-cream">Trabaja con nosotros</a>
    </div>
  </div>
</footer>
