---
import { NAP } from '../../lib/nap';
import CtaBlock from '../blocks/CtaBlock.astro';
import Icon from '../ui/Icon.astro';
import type { NombreIcono } from '../ui/Icon.astro';
const BASE_ING = '/academia-de-ingles-en-sevilla-este';

/* `cta` permite apagar el CTA global en las páginas que ya traen el
   suyo propio: dos cierres idénticos seguidos se anulan entre sí. */
interface Props { cta?: boolean }
const { cta = true } = Astro.props;

const cols: { t: string; icono: NombreIcono; links: string[][] }[] = [
  {
    t: 'Estudios',
    icono: 'libro',
    links: [
      ['Clases de apoyo', '/clases-de-apoyo/'],
      ['Clases particulares', '/clases-particulares-sevilla/'],
      ['Cursos de verano', '/cursos-verano-sevilla/'],
      ['Cursos de invierno', '/cursos-de-invierno/'],
    ],
  },
  {
    t: 'Pruebas de acceso',
    icono: 'diploma',
    links: [
      ['Selectividad PEvAU', '/curso-selectividad-sevilla-pevau/'],
      ['Intensivos PEvAU', '/curso-intensivos-selectividad-pevau/'],
      ['Grado Superior', '/prueba-acceso-grado-superior-sevilla/'],
      ['Grado Medio', '/acceso-grado-medio-academia-sevilla/'],
      ['Mayores de 25 y 45', '/acceso-universidad-mayores-25/'],
      ['Título de ESO', '/conseguir-titulo-eso/'],
      ['Fechas y convocatorias', '/fechas-y-convocatorias/'],
    ],
  },
  {
    t: 'Inglés',
    icono: 'globo',
    links: [
      ['Niños', `${BASE_ING}/ninos/`],
      ['Teens', `${BASE_ING}/teens/`],
      ['Adultos', `${BASE_ING}/adultos/`],
      ['Trinity', `${BASE_ING}/trinity/`],
      ['Cambridge', `${BASE_ING}/cambridge/`],
      ['APTIS', `${BASE_ING}/aptis/`],
      ['B1 · B2 · C1', `${BASE_ING}/b1/`],
      ['Intensivos', `${BASE_ING}/intensivos/`],
    ],
  },
  {
    t: 'Academia',
    icono: 'academia',
    links: [
      ['Quiénes somos', '/quienes-somos-academia-educana/'],
      ['Horarios y precios', '/horarios-cursos/'],
      ['Noticias', '/noticias-academia-educana/'],
      ['Trabaja con nosotros', '/bolsa-de-trabajo-academia-sevilla/'],
      ['Contacto', '/contacto/'],
    ],
  },
];

---
{cta && <CtaBlock />}

{/* Arranca en el azul corporativo exacto y se oscurece al bajar. El
    borde de ARRIBA no se toca: es el que hace tope con el rojo final
    del CTA de cierre, y ahí estaba medido el salto. */}
<footer class="text-white print:hidden"
        style="background: linear-gradient(175deg, #21307F 0%, #141A33 100%);">
  <div class="container-pie grid gap-10 py-14 md:grid-cols-[1fr_1fr_1fr_1fr_1.1fr]">
    {cols.map((c) => (
      <div>
        {/* Alto fijo de dos líneas: "Pruebas de acceso" parte en dos y sin
            esto su lista arrancaba más abajo, descuadrando los filetes. */}
        <h2 class="mb-3 flex min-h-[2.6rem] items-start gap-2 font-body text-[0.8rem] font-bold uppercase tracking-[0.14em] leading-snug text-white">
          <Icon name={c.icono} class="-mt-0.5 text-amber" />
          {c.t}
        </h2>
        {/* Los enlaces van pegados y separados por un filete, no por aire:
            así la columna se lee como un índice y no como una lista suelta. */}
        <ul class="flex flex-col divide-y divide-white/12 border-y border-white/12 text-[1.02rem]">
          {c.links.map(([l, h]) => (
            <li>
              <a href={h} class="group flex items-center gap-1.5 py-1 text-white/85 hover:text-white transition-colors">
                <Icon name="flecha" size="sm" class="-ml-0.5 text-amber transition-transform group-hover:translate-x-0.5" />
                {l}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="flex flex-col gap-4 md:col-span-4 lg:col-span-1">
      <img src="/logo-educana-oscuro.png" alt="Academia Educana" width="350" height="157" class="h-20 w-auto self-start" />
      <address class="not-italic text-[1rem] leading-relaxed text-white/85">
        <span class="flex gap-2.5">
          <Icon name="ubicacion" class="mt-0.5 text-amber" />
          <span>{NAP.street}<br />{NAP.postal} {NAP.city}</span>
        </span>
        {/* Cada teléfono en su fila y en negrita: son el dato que la
            gente viene a buscar y en una sola línea separados por un
            punto se leían como un bloque, no como dos números. */}
        <span class="mt-2.5 flex items-center gap-2.5">
          <Icon name="telefono" class="text-amber" />
          <a href={`tel:${NAP.phone}`} class="font-bold tabular hover:text-white">{NAP.phoneText}</a>
        </span>
        <span class="mt-1 flex items-center gap-2.5">
          <Icon name="movil" class="text-amber" />
          <a href={`tel:${NAP.mobile}`} class="font-bold tabular hover:text-white">{NAP.mobileText}</a>
        </span>
        <span class="mt-1 flex items-center gap-2.5">
          <Icon name="whatsapp" class="text-whatsapp" />
          <a href={NAP.whatsapp} rel="noopener" data-evento="clic-whatsapp"
             class="font-bold tabular hover:text-white">{NAP.mobileText}</a>
          <span class="text-[0.85rem] font-normal text-white/70">WhatsApp</span>
        </span>
        <span class="mt-2.5 flex items-center gap-2.5">
          <Icon name="email" class="text-amber" />
          <a href={`mailto:${NAP.email}`} class="font-bold break-all hover:text-white">{NAP.email}</a>
        </span>
      </address>
    </div>
  </div>
  <div class="border-t border-white/12">
    <div class="container-pie flex flex-wrap gap-x-6 gap-y-2 py-5 text-[0.9rem] text-white/85">
      <span>© {new Date().getFullYear()} Academia Educana</span>
      <a href="/aviso-legal/" class="hover:text-white">Aviso legal</a>
      <a href="/politica-de-privacidad/" class="hover:text-white">Privacidad</a>
      <a href="/politica-de-cookies/" class="hover:text-white">Cookies</a>
      <a href="/preguntas-frecuentes/" class="hover:text-white">Preguntas frecuentes</a>
      <a href="/noticias-academia-educana/" class="ml-auto hover:text-white">Noticias</a>
      <a href="/bolsa-de-trabajo-academia-sevilla/" class="hover:text-white">Trabaja con nosotros</a>
    </div>
  </div>
</footer>
