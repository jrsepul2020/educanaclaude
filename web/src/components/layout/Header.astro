---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
/* Cabecera en BLANCO (17-09-2026). Antes iba sobre azul, pero las
   cabeceras de página pasaron a llevar el degradado del servicio y dos
   azules pegados se empastaban; en blanco, el color de cada sección
   arranca limpio justo debajo.

   Cambia el logotipo: el `oscuro` lleva el texto en crema y es el de
   fondo oscuro; sobre blanco va el `claro`, con el texto en azul.

   Menú completo: cada página real del sitio tiene que estar aquí
   (17-09-2026, corrección del cliente: el menú anterior sólo enlazaba
   una página por grupo y faltaban las 10 subpáginas de inglés). */
const BASE_ING = '/academia-de-ingles-en-sevilla-este';

const menu = [
  {
    label: 'Estudios',
    items: [
      ['Clases de apoyo', '/clases-de-apoyo/'],
      ['Clases particulares', '/clases-particulares-sevilla/'],
      ['Cursos de verano', '/cursos-verano-sevilla/'],
      ['Cursos de invierno', '/cursos-de-invierno/'],
    ],
  },
  {
    label: 'Pruebas de acceso',
    items: [
      ['Selectividad PAU', '/curso-selectividad-sevilla-pevau/'],
      ['Intensivos PAU', '/curso-intensivos-selectividad-pevau/'],
      ['Grado Superior', '/prueba-acceso-grado-superior-sevilla/'],
      ['Grado Medio', '/acceso-grado-medio-academia-sevilla/'],
      ['Mayores de 25 o 45 años', '/acceso-universidad-mayores-25/'],
      ['Título de ESO', '/conseguir-titulo-eso/'],
      ['Fechas y convocatorias', '/fechas-y-convocatorias/'],
    ],
  },
  {
    label: 'Inglés',
    href: `${BASE_ING}/`,
    hrefLabel: 'Ver toda la sección de inglés',
    items: [
      ['Inglés para niños', `${BASE_ING}/ninos/`],
      ['Inglés para teens', `${BASE_ING}/teens/`],
      ['Inglés para adultos', `${BASE_ING}/adultos/`],
      ['Trinity', `${BASE_ING}/trinity/`],
      ['Cambridge', `${BASE_ING}/cambridge/`],
      ['APTIS', `${BASE_ING}/aptis/`],
      ['Nivel B1', `${BASE_ING}/b1/`],
      ['Nivel B2', `${BASE_ING}/b2/`],
      ['Nivel C1', `${BASE_ING}/c1/`],
      ['Intensivos de inglés', `${BASE_ING}/intensivos/`],
    ],
  },
  { label: 'Horarios', href: '/horarios-cursos/' },
  {
    label: 'Academia',
    items: [
      ['Quiénes somos', '/quienes-somos-academia-educana/'],
      ['Noticias', '/noticias-academia-educana/'],
      ['Trabaja con nosotros', '/bolsa-de-trabajo-academia-sevilla/'],
    ],
  },
  { label: 'Contacto', href: '/contacto/' },
];
---
<header class="relative z-50 border-b border-line bg-white text-ink">
  <div class="container-page flex items-center gap-8 py-4">
    <a href="/" class="shrink-0" aria-label="Academia Educana — inicio">
      <img src="/logo-educana-claro.png" alt="Academia Educana" width="350" height="157" class="h-10 w-auto self-start md:h-12" />
    </a>

    <nav aria-label="Principal" class="hidden xl:flex items-center gap-1">
      {menu.map((i) =>
        i.items ? (
          <details class="nav-drop group relative">
            <summary class="flex cursor-pointer list-none items-center gap-1.5 whitespace-nowrap rounded px-2.5 py-2 text-[0.94rem] font-semibold text-ink/80 marker:content-none hover:text-brand-ink">
              {i.label}
              <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="mt-0.5 shrink-0 transition-transform duration-150 group-open:rotate-180">
                <path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="absolute left-0 top-full z-10 mt-2 w-64 border border-line bg-paper py-2 text-ink shadow-lg">
              {i.href && (
                <a href={i.href} class="flex items-center justify-between gap-2 border-b border-line px-4 py-2.5 text-[0.9rem] font-bold text-brand-ink hover:bg-ink/4">
                  {i.hrefLabel}
                  <Icon name="flecha" size="sm" />
                </a>
              )}
              {i.items.map(([l, h]) => (
                <a href={h} class="flex items-center px-4 py-2.5 text-[0.9rem] hover:bg-ink/4 hover:text-brand-ink">
                  {l}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a href={i.href} class="whitespace-nowrap rounded px-2.5 py-2 text-[0.94rem] font-semibold text-ink/80 hover:text-brand-ink">{i.label}</a>
        )
      )}
    </nav>

    <div class="ml-auto flex items-center gap-4">
      <a href="tel:+34954409696" class="hidden xl:inline-flex items-center gap-1.5 whitespace-nowrap text-[0.92rem] font-semibold text-ink/80 hover:text-brand-ink tabular" data-evento="clic-telefono">
        <Icon name="telefono" size="sm" class="text-brand" />
        954 40 96 96
      </a>
      <Button href="/contacto/" icon="info" size="sm" class="hidden sm:inline-flex">Pide información</Button>
      <button type="button" class="xl:hidden p-2 -mr-2" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil" data-menu-toggle>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <nav id="menu-movil" aria-label="Principal móvil" hidden class="xl:hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-line">
    <ul class="container-page flex flex-col py-2">
      {menu.map((i) => (
        <li class="border-b border-line">
          {i.items ? (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-2 py-3.5 font-semibold text-ink marker:content-none">
                {i.label}
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="shrink-0 transition-transform duration-150 group-open:rotate-180"><path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <ul class="flex flex-col gap-0.5 pb-3">
                {i.href && (
                  <li><a href={i.href} class="flex items-center justify-between gap-2 py-2 pl-3 text-[0.92rem] font-bold text-brand-ink">
                    {i.hrefLabel}
                    <Icon name="flecha" size="sm" />
                  </a></li>
                )}
                {i.items.map(([l, h]) => (
                  <li><a href={h} class="flex items-center py-2 pl-3 text-[0.92rem] text-slate">
                    {l}
                  </a></li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={i.href} class="block py-3.5 font-semibold text-ink">{i.label}</a>
          )}
        </li>
      ))}
      <li><a href="/contacto/" class="flex items-center gap-2 py-3.5 font-bold text-brand-ink"><Icon name="info" />Pide información</a></li>
    </ul>
  </nav>
</header>

<script>
  /* Menú móvil: abre/cierra el panel. */
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('menu-movil');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Abrir menú' : 'Cerrar menú');
    if (menu) menu.hidden = open;
  });

  /* Desplegables de escritorio: sólo uno abierto a la vez, y se cierran
     al hacer clic fuera o al pulsar Escape. ~500 bytes — no justifica
     una isla de React. */
  const drops = document.querySelectorAll<HTMLDetailsElement>('.nav-drop');
  drops.forEach((d) => {
    d.addEventListener('toggle', () => {
      if (d.open) drops.forEach((o) => { if (o !== d) o.open = false; });
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Node)) return;
    drops.forEach((d) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') drops.forEach((d) => { d.open = false; });
  });
</script>
