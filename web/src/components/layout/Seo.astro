---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  image?: string;
}
const { title, description, canonical, noindex = false, image = '/og-default.jpg' } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
/* El título que llega es el definitivo. No se le añade nada: el sufijo
   de marca empujaba los títulos por encima de los ~60 caracteres que
   Google muestra, y lo que se cortaba era justo la palabra clave. */
const full = title;
---
<title>{full}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:title" content={full} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:locale" content="es_ES" />
<meta property="og:image" content={new URL(image, Astro.site).href} />
<meta name="twitter:card" content="summary_large_image" />
