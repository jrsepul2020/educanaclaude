---
import Icon from '../ui/Icon.astro';
/* Para una academia local la llamada sigue siendo la conversión reina.
   Objetivos táctiles de 56 px, muy por encima del mínimo de 44.

   WhatsApp va con su verde corporativo: es el color con el que la gente
   reconoce el canal antes de leer la etiqueta. */
---
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 bg-blue text-cream lg:hidden print:hidden">
  <a href="tel:+34954409696" class="flex h-14 items-center justify-center gap-2 border-r border-cream/15 text-sm font-semibold" data-evento="clic-telefono">
    <Icon name="telefono" />
    Llamar
  </a>
  <a href="https://wa.me/34686085566" class="flex h-14 items-center justify-center gap-2 border-r border-cream/15 bg-whatsapp text-sm font-semibold text-ink" data-evento="clic-whatsapp" rel="noopener">
    <Icon name="whatsapp" />
    WhatsApp
  </a>
  <a href="/contacto/" class="flex h-14 items-center justify-center gap-2 text-sm font-semibold text-amber">
    <Icon name="info" />
    Información
  </a>
</div>
<div class="h-14 lg:hidden print:hidden" aria-hidden="true"></div>
