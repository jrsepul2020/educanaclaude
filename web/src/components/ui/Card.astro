---
interface Props { tone?: 'paper' | 'azul'; class?: string }
const { tone = 'paper', class: extra = '' } = Astro.props;
const tones: Record<NonNullable<Props['tone']>, string> = {
  paper: 'bg-paper border border-line',
  azul: 'bg-blue text-cream border border-blue',
};
---
<div class={`rounded-card overflow-hidden flex flex-col ${tones[tone]} ${extra}`}><slot /></div>
