---
/* Set único de iconos de la web. Planos y lineales, 24×24, trazo
   uniforme y `currentColor`: heredan el color del texto que acompañan,
   así que sirven igual sobre crema que sobre azul.

   Regla del proyecto: todo enlace o botón con una acción reconocible
   lleva su icono (teléfono, correo, WhatsApp, ubicación…). Nunca emoji.

   `whatsapp` es la única excepción de estilo: al ser un logotipo de
   marca se usa el glifo oficial relleno, no una interpretación lineal. */
export type NombreIcono =
  | 'telefono' | 'email' | 'whatsapp' | 'ubicacion'
  | 'flecha' | 'flecha-larga' | 'externo' | 'descarga'
  | 'reloj' | 'calendario' | 'documento' | 'usuarios'
  | 'libro' | 'diploma' | 'globo' | 'academia'
  | 'info' | 'chat' | 'casa' | 'check' | 'megafono' | 'euro';

interface Props {
  name: NombreIcono;
  /** sm 16 · md 20 (por defecto) · lg 24 · xl 40 · 2xl 56px */
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  class?: string;
}
const { name, size = 'md', class: extra = '' } = Astro.props;
const px = { sm: 16, md: 20, lg: 24, xl: 40, '2xl': 56 }[size];

const trazos: Record<string, string> = {
