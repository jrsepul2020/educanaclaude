  reloj: 'M12 6.75V12l3.25 2.25 M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z',
  calendario: 'M4.5 6.5h15v14h-15Z M4.5 11h15 M8.5 3.5v5 M15.5 3.5v5',
  documento: 'M6 3.5h7.5L18 8v12.5H6Z M13.5 3.5V8H18',
  usuarios: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z M4 21c0-4 3.5-7 8-7s8 3 8 7',
  libro: 'M4 5.5c0-1 1-1.5 2-1.5h5.5v13H6c-1 0-2 .5-2 1.5V5.5Z M19.5 19.5H13.5V6.5C13.5 5.5 14.5 5 15.5 5H19.5v14.5Z',
  diploma: 'M8 3h8v9l-4 2.5L8 12V3Z M6 21l3-6 3 2 3-2 3 6',
