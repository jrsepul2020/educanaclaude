  flecha: 'm9 5.5 6.5 6.5L9 18.5',
  'flecha-larga': 'M4 12h15.5 M13.5 6l6 6-6 6',
  externo: 'M13.5 4.5h6v6 M19.5 4.5 11 13 M17 13.5v5a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 4 18.5v-10A1.5 1.5 0 0 1 5.5 7h5',
