---
/* Acordeón con <details> nativo: 0 KB de JavaScript, accesible de serie
   y funciona con el buscador de la página (Ctrl+F) abierto o cerrado. */
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="rounded-card border border-line bg-paper divide-y divide-line">
  {items.map((it) => (
    <details class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold hover:bg-ink/3">
        <span>{it.q}</span>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"
             class="shrink-0 text-brand transition-transform duration-200 group-open:rotate-45">
          <path d="M10 4.5v11M4.5 10h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </summary>
      <div class="px-5 pb-5 text-slate leading-relaxed">{it.a}</div>
    </details>
  ))}
</div>

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
})} />
