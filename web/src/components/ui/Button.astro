---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'md' | 'sm';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  disabled?: boolean;
}
const { variant = 'primary', size = 'md', href, type = 'button', class: extra = '', disabled = false } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-semibold rounded-pill transition-colors duration-150 ' +
  'disabled:opacity-45 disabled:pointer-events-none';
const sizes = {
  md: 'h-13 px-7 text-[0.97rem]',
  sm: 'h-10 px-5 text-sm',
};
const variants = {
  primary: 'bg-brand text-white hover:bg-brand-ink',
  secondary: 'bg-ink text-cream hover:bg-ink-soft',
  outline: 'border-[1.5px] border-ink/30 text-ink hover:border-ink hover:bg-ink/5',
  ghost: 'text-brand-ink hover:bg-brand/8 px-3',
};
const cls = [base, sizes[size], variants[variant], extra].join(' ');
const Tag = href ? 'a' : 'button';
---
<Tag
  class={cls}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  aria-disabled={href && disabled ? 'true' : undefined}
><slot /></Tag>
