---
interface Props { tone?: 'neutral' | 'brand' | 'amber' | 'azul' | 'ok'; class?: string }
const { tone = 'neutral', class: extra = '' } = Astro.props;
const tones = {
  neutral: 'bg-ink/8 text-slate',
  brand: 'bg-brand/10 text-brand-ink',
  amber: 'bg-amber text-ink',
  azul: 'bg-blue text-cream',
  ok: 'bg-ok/12 text-ok',
};
---
<span class={`inline-flex items-center h-7 px-3 rounded-pill text-[0.7rem] font-bold uppercase tracking-[0.06em] ${tones[tone]} ${extra}`}>
  <slot />
</span>
