---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Eyebrow from './Eyebrow.astro';
import PhotoPlaceholder from '../ui/PhotoPlaceholder.astro';
import { foto } from '../../lib/foto';
/* El diferencial de la marca. Sobre tinta, con acentos en ÁMBAR:
   el rojo sobre tinta da 2,88:1 y falla el contraste (doc 02 §2).
   El logotipo Trinity NO es una foto: es un archivo que autoriza
   Trinity College London. Usa el mismo mecanismo de foto() para que
   aparezca en cuanto se suba, sin tocar código. */
const src = foto('trinity-sello.png');

/* Fondo de bandera británica. El velo es alto (0,86 bajando a 0,74 en
   la mitad derecha) por dos motivos, no por contraste: las franjas
   blancas son blanco puro, y el rojo de la bandera está a un paso del
   rojo de marca, así que si se ve demasiado le roba fuerza al botón
   principal. A este nivel queda como textura, que es lo que debe ser.

   El original que subió el cliente pesa 13,9 MB a 4928 px: aquí se usa
   la versión reducida a 1600 px y 277 KB. */
const fondo = '/fotos/fondos/trinity-english-web.jpg';

const ventajas = [
  'Preparas y te examinas en el mismo centro: sin desplazarte el día del examen.',
  'Mismos profesores, misma aula y el mismo ritmo de todo el curso.',
  'Gestionamos la inscripción y las convocatorias de Trinity por ti.',
  'A1, A2, B1, B2, C1, C2 e ISE Digital, con título oficial válido en todo el mundo.',
];
---
<section
  class="bg-blue bg-cover bg-center text-cream py-24 md:py-36"
  style={`background-image: linear-gradient(100deg, rgb(23 32 77 / 0.92) 0%, rgb(23 32 77 / 0.86) 55%, rgb(20 26 51 / 0.74) 100%), url("${fondo}");`}
>
  <div class="container-page grid items-start gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-14 xl:grid-cols-[1fr_1fr_15rem]">

    <div class="flex flex-col gap-5">
      <Eyebrow tone="amber">Centro oficial Trinity</Eyebrow>
      {/* Un escalón por debajo del H2 del resto del sitio: aquí el
          titular convive con cuatro ventajas y el logotipo, y a
          tamaño completo se comía la franja. */}
      <h2 class="text-[clamp(1.5rem,1.15rem+1.5vw,2.2rem)] leading-[1.05]">Estudia inglés en nuestra academia en Sevilla Este.</h2>
      <p class="text-(length:--text-lead) leading-relaxed text-cream/75 max-w-[54ch]">
        Somos centro examinador oficial de Trinity College London. Mismos profesores,
        misma aula, sin desplazarte a otro centro el día del examen. A1, A2, B1, B2, C1, C2 e ISE Digital.
      </p>
      <div class="flex flex-wrap gap-3">
        <Button href="/academia-de-ingles-en-sevilla-este/trinity/" icon="globo" variant="rojo-aro">Ver preparación Trinity</Button>
        <Button href="/fechas-y-convocatorias/" icon="calendario" variant="trans-claro">Próximas convocatorias</Button>
      </div>
    </div>

    <ul class="flex flex-col gap-4 lg:border-l lg:border-cream/20 lg:pl-10">
      {ventajas.map((v) => (
        <li class="flex items-start gap-3">
          <Icon name="check" class="mt-1 shrink-0 text-amber" />
          <span class="max-w-[46ch] text-[1.05rem] leading-relaxed text-cream">{v}</span>
        </li>
      ))}
    </ul>

    <div class="flex flex-row flex-wrap items-start gap-4 xl:flex-col">
      {src
        ? <img src={src} alt="Sello de centro examinador oficial de Trinity College London" width="260" height="260" class="w-40 rounded-card bg-paper p-4 xl:w-full" />
        : <PhotoPlaceholder nombre="trinity-sello.png" medidas="Logotipo oficial en PNG con fondo transparente"
            nota="No es una foto: pídelo a Trinity College London junto con tu nº de centro examinador."
            class="w-full rounded-card border-cream/30 bg-transparent text-cream/70" />}
    </div>
  </div>
</section>
