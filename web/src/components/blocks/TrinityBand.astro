---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import Eyebrow from './Eyebrow.astro';
import PhotoPlaceholder from '../ui/PhotoPlaceholder.astro';
import { foto } from '../../lib/foto';
/* El diferencial de la marca. Sobre tinta, con acentos en ÁMBAR:
   el rojo sobre tinta da 2,88:1 y falla el contraste (doc 02 §2).
   El logotipo Trinity NO es una foto: es un archivo que autoriza
   Trinity College London. Usa el mismo mecanismo de foto() para que
   aparezca solo en cuanto se suba, sin tocar código. */
const src = foto('trinity-sello.png');
---
<section class="bg-blue text-cream py-14 md:py-20">
  <div class="container-page grid items-center gap-10 md:grid-cols-[1.1fr_0.7fr]">
    <div class="flex flex-col gap-5">
      <Eyebrow tone="amber">Centro examinador oficial</Eyebrow>
      <h2 class="text-(length:--text-h2)">Preparas el Trinity aquí. Y te examinas aquí.</h2>
      <p class="text-(length:--text-lead) leading-relaxed text-cream/75 max-w-[54ch]">
        Somos centro examinador oficial de Trinity College London. Mismos profesores,
        misma aula, sin desplazarte a otro centro el día del examen. B1, B2, C1 y C2.
      </p>
      <div class="flex flex-wrap gap-3">
        <Button href="/academia-de-ingles-en-sevilla-este/trinity/">Ver preparación Trinity</Button>
        <Button href="/fechas-y-convocatorias/" variant="outline">Próximas convocatorias</Button>
      </div>
    </div>
    <div class="flex flex-col items-start gap-4">
      <Badge tone="amber">Centro examinador</Badge>
      {src
        ? <img src={src} alt="Sello de centro examinador oficial de Trinity College London" width="260" height="260" class="w-full max-w-56 rounded-card bg-paper p-4" />
        : <PhotoPlaceholder nombre="trinity-sello.png" medidas="Logotipo oficial en PNG con fondo transparente"
            nota="No es una foto: pídelo a Trinity College London junto con tu nº de centro examinador."
            class="w-full rounded-card border-cream/30 bg-transparent text-cream/70" />}
    </div>
  </div>
</section>
