---
interface Props { stats: { n: string; label: string; accent?: boolean; icon?: 'anios' | 'alumnos' | 'examenes' | 'gratis' }[] }
const { stats } = Astro.props;

/* Un icono lineal por dato — mismo lenguaje visual que el footer,
   nunca emoji (doc 04). Ayuda a que la banda de cifras se lea como
   un bloque de autoridad, no como texto suelto. */
const iconos: Record<string, string> = {
  anios: 'M12 8v4l3 2 M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z',
  alumnos: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z M4 21c0-4 3.5-7 8-7s8 3 8 7',
  examenes: 'M8 3h8v9l-4 2.5L8 12V3Z M6 21l3-6 3 2 3-2 3 6',
  gratis: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z M9 10h.01M15 10h.01M8.5 14.5c1 1 2 1.5 3.5 1.5s2.5-.5 3.5-1.5',
};

/* Las columnas salen del número de datos, no fijas a cuatro: al quitar
   una cifra la rejilla dejaba un hueco vacío al final de la fila. */
const cols = { 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4' }[stats.length] ?? 'lg:grid-cols-4';
---
<div class={`grid gap-5 sm:grid-cols-2 ${cols}`}>
  {stats.map((s) => (
    <div class="rounded-card border border-line bg-paper p-6 flex flex-col gap-3">
      {s.icon && (
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" class={s.accent ? 'text-brand' : 'text-brand-ink'}>
          <path d={iconos[s.icon]} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      )}
      <p class={`font-display text-[3rem] leading-none tracking-tight ${s.accent ? 'text-brand' : ''}`}>{s.n}</p>
      <p class="text-sm leading-snug text-slate">{s.label}</p>
    </div>
  ))}
</div>
