---
interface Props { stats: { n: string; label: string; accent?: boolean }[] }
const { stats } = Astro.props;
---
<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
  {stats.map((s) => (
    <div>
      <p class={`font-display text-[3.4rem] leading-none tracking-tight ${s.accent ? 'text-brand' : ''}`}>{s.n}</p>
      <p class="mt-2 text-sm leading-snug text-slate">{s.label}</p>
    </div>
  ))}
</div>
