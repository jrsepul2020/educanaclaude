---
/* La caja de datos duros: lo que decide la conversión y lo que la web
   actual esconde (doc 05 §5). Va siempre justo bajo el H1. */
interface Props { items: { k: string; v: string }[] }
const { items } = Astro.props;
---
<dl class="grid gap-6 rounded-card border-[1.5px] border-ink bg-paper p-6 sm:grid-cols-2 lg:grid-cols-5">
  {items.map((i) => (
    <div>
      <dt class="text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-slate">{i.k}</dt>
      <dd class="mt-1.5 text-[1.05rem] font-bold leading-tight tabular">{i.v}</dd>
    </div>
  ))}
</dl>
