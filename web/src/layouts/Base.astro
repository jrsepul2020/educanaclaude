---
import '../styles/tokens.css';
import Seo from '../components/layout/Seo.astro';
import Schema from '../components/layout/Schema.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileBar from '../components/layout/MobileBar.astro';
import Consent from '../components/layout/Consent.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  chrome?: boolean;
  /** false en páginas que traen su propio cierre, para no repetirlo */
  cta?: boolean;
}
const { title, description, noindex = false, schema, chrome = true, cta = true } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <Seo title={title} description={description} noindex={noindex} />
    <Schema extra={schema} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-field focus:bg-ink focus:px-4 focus:py-3 focus:text-cream">
      Saltar al contenido
    </a>
    {chrome && <Header />}
    <main id="contenido" class="flex-1"><slot /></main>
    {chrome && <Footer cta={cta} />}
    {chrome && <MobileBar />}
    <Consent />
  </body>
</html>
