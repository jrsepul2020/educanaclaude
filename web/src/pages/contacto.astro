---
import Base from '../layouts/Base.astro';
import Section from '../components/blocks/Section.astro';
import Eyebrow from '../components/blocks/Eyebrow.astro';
import LeadForm from '../components/blocks/LeadForm.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import PageHeader from '../components/blocks/PageHeader.astro';
import { NAP } from '../lib/nap';
---
<Base
  title="Contacto · Academia Educana Sevilla Este"
  description="Academia Educana está en Avenida de las Ciencias 25, Edificio Galileo, Sevilla Este. Llámanos al 954 40 96 96 o escríbenos por WhatsApp."
>
  <PageHeader
    migas={[{ label: 'Contacto' }]}
    eyebrow="Contacto"
    titulo="Estamos en Sevilla Este, en el Edificio Galileo."
    tituloClass="max-w-[20ch]"
  >
    <p class="text-(length:--text-lead) leading-relaxed text-cream/80 max-w-[58ch]">
      Llámanos, escríbenos por WhatsApp o pásate. Te decimos en qué grupo encajas,
      cuándo empieza y cuánto cuesta.
    </p>
    <div class="flex flex-wrap gap-3">
      <Button href={`tel:${NAP.phone}`} icon="telefono" variant="blanco" class="tabular">{NAP.phoneText}</Button>
      <Button href={NAP.whatsapp} icon="whatsapp" variant="whatsapp">WhatsApp</Button>
    </div>
  </PageHeader>

  <Section tone="paper">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr]">
      <div class="flex flex-col gap-5">
        <h2 class="text-(length:--text-h2)">Pide información</h2>
        <p id="error-form" hidden class="rounded-field border-2 border-brand-ink bg-paper p-4 text-[0.92rem] leading-relaxed"></p>
        <LeadForm context="contacto" />
      </div>

      <div class="flex flex-col gap-5">
        <Card class="gap-4 p-6">
          <h2 class="text-(length:--text-h3)">{NAP.name}</h2>
          <address class="not-italic leading-relaxed text-slate flex flex-col gap-3">
            <span class="flex gap-2.5">
              <Icon name="ubicacion" class="mt-0.5 text-brand-ink" />
              <span>{NAP.street}<br />{NAP.postal} {NAP.city}</span>
            </span>
            <a href={`tel:${NAP.phone}`} class="flex items-center gap-2.5 tabular text-ink hover:text-brand-ink" data-evento="clic-telefono">
              <Icon name="telefono" class="text-brand-ink" />
              {NAP.phoneText}
            </a>
            <a href={`tel:${NAP.mobile}`} class="flex items-center gap-2.5 tabular text-ink hover:text-brand-ink" data-evento="clic-telefono">
              <Icon name="telefono" class="text-brand-ink" />
              {NAP.mobileText}
            </a>
            <a href={`mailto:${NAP.email}`} class="flex items-center gap-2.5 text-ink hover:text-brand-ink">
              <Icon name="email" class="text-brand-ink" />
              {NAP.email}
            </a>
          </address>
          <Button href={NAP.whatsapp} icon="whatsapp" variant="whatsapp" size="sm" class="self-start">Escribir por WhatsApp</Button>
        </Card>

        <Card class="gap-3 p-6">
          <h2 class="text-(length:--text-h3)">Otros contactos</h2>
          <dl class="flex flex-col gap-2 text-[0.95rem]">
            <div><dt class="text-slate">Bolsa de trabajo</dt>
              <dd><a href={`mailto:${NAP.emailEmpleo}`} class="flex items-center gap-2 hover:text-brand-ink"><Icon name="email" size="sm" class="text-brand-ink" />{NAP.emailEmpleo}</a></dd></div>
            <div><dt class="text-slate">Administración y asuntos legales</dt>
              <dd><a href={`mailto:${NAP.emailLegal}`} class="flex items-center gap-2 hover:text-brand-ink"><Icon name="email" size="sm" class="text-brand-ink" />{NAP.emailLegal}</a></dd></div>
          </dl>
        </Card>
      </div>
    </div>
  </Section>

  <Section tone="cream">
    <Eyebrow>Cómo llegar</Eyebrow>
    <h2 class="text-(length:--text-h2)">Dónde estamos.</h2>
    {/* El mapa se carga al hacer clic: un iframe de Google Maps por encima
        del pliegue hunde el LCP (doc 04). */}
    <button type="button" data-mapa
      class="group relative flex aspect-[21/9] w-full items-center justify-center overflow-hidden rounded-card border border-line bg-paper">
      <span class="flex flex-col items-center gap-2 text-slate">
        <Icon name="ubicacion" size="lg" class="text-brand-ink" />
        <span class="font-semibold text-ink">Ver el mapa</span>
        <span class="text-[0.82rem]">Se carga al pulsar, para no ralentizar la página</span>
      </span>
    </button>

    <p class="max-w-[64ch] leading-relaxed text-slate">
      Estamos en el <strong>Edificio Galileo</strong>, en la Avenida de las Ciencias, en pleno
      Sevilla Este.
    </p>
  </Section>
</Base>

<script>
  const MOTIVOS: Record<string, string> = {
    nombre: 'Escribe tu nombre para que sepamos cómo dirigirnos a ti.',
    telefono: 'Revisa el teléfono: necesitamos nueve cifras para poder llamarte.',
    rgpd: 'Hay que aceptar la política de privacidad para poder guardar tus datos.',
    'mensaje-largo': 'El mensaje es demasiado largo. Resúmelo y te llamamos para los detalles.',
    'spam-enlaces': 'El mensaje tiene demasiados enlaces y no ha pasado el filtro. Escríbenos sin ellos.',
  };
  const err = new URLSearchParams(location.search).get('error');
  const caja = document.getElementById('error-form');
  if (err && caja && MOTIVOS[err]) {
    caja.textContent = MOTIVOS[err];
    caja.hidden = false;
    caja.scrollIntoView({ block: 'center' });
  }

  const btn = document.querySelector<HTMLButtonElement>('[data-mapa]');
  btn?.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = 'https://www.google.com/maps?q=Avenida+de+las+Ciencias+25+Sevilla&output=embed';
    f.title = 'Mapa de la academia';
    f.loading = 'lazy';
    f.className = 'h-full w-full border-0';
    btn.replaceWith(f);
  }, { once: true });
</script>
