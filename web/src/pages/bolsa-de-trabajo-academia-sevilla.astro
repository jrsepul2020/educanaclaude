---
import Base from '../layouts/Base.astro';
import Section from '../components/blocks/Section.astro';
import PageHeader from '../components/blocks/PageHeader.astro';
import Field from '../components/ui/Field.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import { NAP } from '../lib/nap';
/* 65 clics al año en posición 9,3: más tráfico que clases particulares.
   Contenido y requisitos tomados de la página actual (doc 10). */
---
<Base
  title="Trabaja con nosotros · Academia Educana"
  description="Bolsa de trabajo de Academia Educana, Sevilla Este. Envíanos tu currículum indicando las asignaturas que puedes impartir, tu experiencia y tu disponibilidad."
>
  <PageHeader
    migas={[{ label: 'Trabaja con nosotros' }]}
    eyebrow="Bolsa de trabajo"
    titulo="¿Quieres dar clase con nosotros?"
    tituloClass="max-w-[18ch]"
  >
    <p class="text-(length:--text-lead) leading-relaxed text-cream/80 max-w-[58ch]">
      Escríbenos a través del formulario adjuntando tu currículum, o mándanoslo
      directamente por correo.
    </p>
    <Button href={`mailto:${NAP.emailEmpleo}`} icon="email" variant="blanco" class="self-start">{NAP.emailEmpleo}</Button>
  </PageHeader>

  <Section tone="paper">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1fr]">
      <div class="flex flex-col gap-6">
        <h2 class="text-(length:--text-h2)">Qué indicar</h2>
        <Card class="gap-4 p-6">
          <ol class="flex list-decimal flex-col gap-3 pl-5 leading-relaxed">
            <li><strong>Todas las asignaturas</strong> que puedes impartir.</li>
            <li>Tu <strong>experiencia laboral</strong>.</li>
            <li>Tu <strong>disponibilidad</strong>.</li>
          </ol>
        </Card>
        <Card class="gap-3 p-6">
          <h3 class="text-(length:--text-h3)">El currículum</h3>
          <p class="leading-relaxed text-slate">
            En formato <strong>PDF, DOC o JPG</strong>, con un tamaño máximo de <strong>3 MB</strong>.
          </p>
        </Card>
        <p class="text-[0.85rem] leading-relaxed text-slate">
          Tus datos se tratan conforme a nuestra
          <a href="/politica-de-privacidad/" class="text-brand-ink underline">política de privacidad</a>.
          Los currículums se conservan durante el proceso de selección y, salvo que nos indiques
          lo contrario, un año para futuros procesos.
        </p>
      </div>

      <Card class="gap-4 self-start p-6">
        <h2 class="text-(length:--text-h3)">Formulario de solicitud</h2>
        <p id="error-form" hidden class="rounded-field border-2 border-brand-ink bg-cream p-4 text-[0.9rem] leading-relaxed"></p>
        <form method="POST" action="/api/empleo" enctype="multipart/form-data" class="flex flex-col gap-4">
          <div class="absolute left-[-9999px]" aria-hidden="true">
            <label>No rellenes esto <input type="text" name="empresa" tabindex="-1" autocomplete="off" /></label>
          </div>
          <Field label="Nombre y apellidos" name="nombre" required autocomplete="name" />
          <Field label="Correo electrónico" name="email" type="email" required autocomplete="email" />
          <Field label="Teléfono" name="telefono" type="tel" required autocomplete="tel" />
          <Field label="Asignaturas que puedes impartir" name="asignaturas" required
                 hint="Todas las que puedas, no sólo la principal." />
          <Field label="Experiencia y disponibilidad" name="mensaje" multiline required
                 hint="Años dando clase, niveles que has llevado y en qué horarios puedes." />

          <div class="flex flex-col gap-2">
            <label for="f-cv" class="text-[0.8rem] font-semibold">
              Sube tu currículum<span class="text-brand-ink" aria-hidden="true"> *</span>
            </label>
            <input id="f-cv" name="cv" type="file" required
                   accept=".pdf,.doc,.docx,.jpg,.jpeg,application/pdf,application/msword,image/jpeg"
                   aria-describedby="f-cv-hint"
                   class="w-full rounded-field border-[1.5px] border-ink/18 bg-paper p-3 text-[0.9rem] file:mr-3 file:rounded-pill file:border-0 file:bg-ink file:px-4 file:py-2 file:text-[0.82rem] file:font-semibold file:text-cream" />
            <p id="f-cv-hint" class="text-[0.78rem] text-slate">PDF, DOC o JPG. Máximo 3 MB.</p>
          </div>

          <label class="flex items-start gap-3 text-[0.8rem] text-slate">
            <input type="checkbox" name="rgpd" required class="mt-0.5 size-4.5 accent-[--color-brand]" />
            <span>Acepto que guardéis mis datos para procesos de selección, según la <a href="/politica-de-privacidad/" class="text-brand-ink underline">política de privacidad</a>.</span>
          </label>
          <Button type="submit" icon="documento">Enviar candidatura</Button>
        </form>
      </Card>
    </div>
  </Section>
</Base>

<script>
  const MOTIVOS: Record<string, string> = {
    nombre: 'Escribe tu nombre y apellidos.',
    telefono: 'Revisa el teléfono: necesitamos nueve cifras para poder llamarte.',
    rgpd: 'Hay que aceptar la política de privacidad para poder guardar tu candidatura.',
    'cv-falta': 'Falta el currículum. Adjúntalo antes de enviar.',
    'cv-grande': 'El currículum pesa más de 3 MB. Comprímelo o mándalo a rrhh@academiaeducana.com.',
    'cv-tipo': 'El currículum tiene que ser PDF, DOC o JPG.',
    'mensaje-largo': 'El texto es demasiado largo. Resúmelo: el detalle ya va en el currículum.',
    'spam-enlaces': 'El mensaje tiene demasiados enlaces y no ha pasado el filtro.',
  };
  const err = new URLSearchParams(location.search).get('error');
  const caja = document.getElementById('error-form');
  if (err && caja && MOTIVOS[err]) {
    caja.textContent = MOTIVOS[err];
    caja.hidden = false;
    caja.scrollIntoView({ block: 'center' });
  }
</script>
