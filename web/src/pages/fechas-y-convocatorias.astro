---
import Base from '../layouts/Base.astro';
import Section from '../components/blocks/Section.astro';
import Eyebrow from '../components/blocks/Eyebrow.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import { getCollection } from 'astro:content';

const trinity = (await getCollection('convocatorias')).map((c) => c.data);

/* Página nueva justificada por datos: las consultas con «2026» ya
   posicionan entre 1,5 y 5,8 sin que exista contenido (doc 07 §6). */
const acceso = [
  { t: 'Presentación de solicitudes', f: 'Del 12 al 23 de enero de 2026' },
  { t: 'Relación provisional de admitidos y excluidos', f: '9 de febrero de 2026' },
  { t: 'Reclamaciones a la relación provisional', f: 'Del 10 al 12 de febrero de 2026' },
  { t: 'Realización de las pruebas', f: 'Del 6 al 30 de abril de 2026', destacado: true },
  { t: 'Publicación del acta con los resultados', f: '4 de mayo de 2026' },
  { t: 'Reclamación a la calificación', f: 'Del 5 al 7 de mayo de 2026' },
  { t: 'Resultados definitivos', f: '11 de mayo de 2026' },
];

const intensivos = [
  { t: 'Intensivo PEvAU de junio', f: 'Del 18 de mayo al 1 de junio · de lunes a sábado', href: '/curso-intensivos-selectividad-pevau/' },
  { t: 'Intensivo PEvAU de julio', f: 'Del 17 al 29 de junio · de lunes a viernes', href: '/curso-intensivos-selectividad-pevau/' },
  { t: 'Intensivo de inglés de verano (B1 y B2)', f: 'Julio, agosto y primera semana de septiembre', href: '/academia-de-ingles-en-sevilla-este/intensivos/' },
  { t: 'Intensivo de inglés de invierno (B1)', f: 'De enero a junio', href: '/academia-de-ingles-en-sevilla-este/intensivos/' },
];

const calendario = [
  { mes: 'Septiembre', items: ['Matrícula del curso', 'Arrancan los grupos de inglés'] },
  { mes: 'Enero', items: ['Recuperaciones de la 1ª evaluación', 'Intensivos de PEvAU'] },
  { mes: 'Abril – Junio', items: ['PEvAU', 'Pruebas de acceso', 'Exámenes Trinity'] },
  { mes: 'Junio – Julio', items: ['Cursos de verano', 'Intensivos de inglés', 'PEvAU extraordinaria'] },
];
---
<Base
  title="Fechas y convocatorias · Academia Educana"
  description="Fechas de examen y plazos de matrícula del curso: PEvAU, pruebas de acceso, mayores de 25 y 45, título de ESO y exámenes de inglés."
>
  <section class="bg-cream pt-8 pb-10 md:pt-10 md:pb-12">
    <div class="container-page flex flex-col gap-6">
      <nav aria-label="Migas de pan" class="text-[0.78rem] text-slate">
        <a href="/" class="hover:text-ink">Inicio</a> <span aria-hidden="true">→</span> <span class="text-ink">Fechas y convocatorias</span>
      </nav>
      <Eyebrow>Curso 2026–2027</Eyebrow>
      <h1 class="text-(length:--text-h1) max-w-[18ch]">Todas las fechas del curso, en un sitio.</h1>
      <p class="text-(length:--text-lead) leading-relaxed text-slate max-w-[60ch]">
        Convocatorias, plazos de matrícula y fechas de examen de la PEvAU, las pruebas de
        acceso y los exámenes oficiales de inglés. Lo actualizamos cada vez que sale la orden.
      </p>
    </div>
  </section>

  <Section tone="paper">
    <Eyebrow>Exámenes Trinity 2026</Eyebrow>
    <h2 class="text-(length:--text-h2)">Se examinan en nuestro centro.</h2>
    <p class="max-w-[64ch] leading-relaxed text-slate">
      Somos centro examinador oficial de Trinity College London. Las partes escrita
      (Reading &amp; Writing) y oral (Speaking &amp; Listening) son independientes y las dos
      se celebran aquí, sin que tengas que desplazarte.
    </p>
    <div class="overflow-x-auto rounded-card border border-line bg-paper">
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">Calendario de exámenes Trinity ISE de 2026</caption>
        <thead>
          <tr class="bg-ink/4">
            <th scope="col" class="border-b border-line px-4 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.1em] text-slate">Convocatoria</th>
            <th scope="col" class="border-b border-line px-4 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.1em] text-slate">Escrito · R&amp;W</th>
            <th scope="col" class="border-b border-line px-4 py-3 text-[0.65rem] font-semibold uppercase tracking-[0.1em] text-slate">Oral · S&amp;L</th>
          </tr>
        </thead>
        <tbody>
          {trinity.map((c) => (
            <tr class="border-b border-line/60 last:border-0">
              <td class="px-4 py-3.5 font-medium">{c.titulo.replace('Trinity ISE · ', '')}</td>
              <td class="px-4 py-3.5 tabular">{c.escrito}</td>
              <td class="px-4 py-3.5 tabular text-slate">{c.oral}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <Button href="/academia-de-ingles-en-sevilla-este/trinity/" variant="outline" class="self-start">Cómo preparamos el Trinity</Button>
  </Section>

  <Section tone="cream">
    <Eyebrow>Acceso a ciclos formativos 2026</Eyebrow>
    <h2 class="text-(length:--text-h2)">Grado Medio y Grado Superior.</h2>
    <p class="max-w-[64ch] leading-relaxed text-slate">
      Las dos pruebas comparten calendario. La Junta de Andalucía convoca una vez al año, en abril.
    </p>
    <ol class="flex flex-col gap-0 overflow-hidden rounded-card border border-line bg-paper">
      {acceso.map((a) => (
        <li class={`flex flex-wrap items-baseline justify-between gap-3 border-b border-line/60 px-5 py-4 last:border-0 ${a.destacado ? 'bg-amber/25' : ''}`}>
          <span class={a.destacado ? 'font-bold' : ''}>{a.t}</span>
          <span class={`tabular ${a.destacado ? 'font-bold' : 'text-slate'}`}>{a.f}</span>
        </li>
      ))}
    </ol>
    <div class="flex flex-wrap gap-3">
      <Button href="/prueba-acceso-grado-superior-sevilla/" variant="outline" size="sm">Acceso a Grado Superior</Button>
      <Button href="/acceso-grado-medio-academia-sevilla/" variant="outline" size="sm">Acceso a Grado Medio</Button>
    </div>
  </Section>

  <Section tone="paper">
    <Eyebrow>Intensivos</Eyebrow>
    <h2 class="text-(length:--text-h2)">Cuándo son los cursos concentrados.</h2>
    <div class="grid gap-5 md:grid-cols-2">
      {intensivos.map((i) => (
        <Card class="gap-2 p-6">
          <h3 class="text-(length:--text-h3)">{i.t}</h3>
          <p class="tabular text-slate">{i.f}</p>
          <a href={i.href} class="text-[0.92rem] font-semibold text-brand-ink">Ver el curso →</a>
        </Card>
      ))}
    </div>
  </Section>

  <Section tone="cream">
    <Eyebrow>Calendario del curso</Eyebrow>
    <h2 class="text-(length:--text-h2)">Mes a mes.</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {calendario.map((c) => (
        <Card class="gap-3 p-5">
          <h3 class="font-semibold">{c.mes}</h3>
          <ul class="flex flex-col gap-1.5 text-[0.92rem] text-slate">
            {c.items.map((i) => <li>{i}</li>)}
          </ul>
        </Card>
      ))}
    </div>
  </Section>

  <Section tone="paper">
    <div class="flex flex-wrap items-center gap-6">
      <div class="flex-1 min-w-[18rem] flex flex-col gap-3">
        <h2 class="text-(length:--text-h2)">¿Llegas a tiempo?</h2>
        <p class="leading-relaxed text-slate">Dinos a qué convocatoria vas y te decimos con franqueza si da tiempo a prepararla.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href="/contacto/">Pregúntanos</Button>
        <Button href="tel:+34954409696" variant="outline">Llamar 954 40 96 96</Button>
      </div>
    </div>
  </Section>
</Base>
