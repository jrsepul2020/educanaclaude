---
import Base from '../layouts/Base.astro';
import Section from '../components/blocks/Section.astro';
import Button from '../components/ui/Button.astro';
/* Página de confirmación propia: sin ella no se puede medir una
   conversión de verdad en GA4 (doc 05 §7). Va en noindex. */
---
<Base title="Gracias" description="Hemos recibido tu mensaje." noindex={true}>
  <Section tone="cream" class="min-h-[60vh] justify-center">
    <h1 class="text-(length:--text-h1)">Recibido. Te llamamos.</h1>
    <p class="text-(length:--text-lead) leading-relaxed text-slate max-w-[52ch]">
      Normalmente contestamos el mismo día. Si tienes prisa, llámanos directamente
      al 954 40 96 96 y lo resolvemos en cinco minutos.
    </p>
    <p id="aviso" hidden class="rounded-card border-2 border-brand bg-paper p-5 leading-relaxed max-w-[52ch]">
      <strong class="text-brand-ink">Ha fallado el envío del correo.</strong> Tu mensaje puede no
      habernos llegado. Llámanos al <a href="tel:+34954409696" class="underline tabular">954 40 96 96</a>
      y lo resolvemos ahora mismo.
    </p>
    <div class="flex flex-wrap gap-3">
      <Button href="tel:+34954409696" icon="telefono" class="tabular">954 40 96 96</Button>
      <Button href="/horarios-cursos/" icon="reloj" variant="outline">Ver los horarios</Button>
      <Button href="/" icon="casa" variant="outline">Volver al inicio</Button>
    </div>
  </Section>
</Base>

<script>
  /* Si el correo falló, el endpoint redirige con ?aviso=email.
     Antes que perder el contacto en silencio, se le pide que llame. */
  if (new URLSearchParams(location.search).get('aviso') === 'email') {
    const a = document.getElementById('aviso');
    if (a) a.hidden = false;
  }
</script>
