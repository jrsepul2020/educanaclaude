---
import Base from '../layouts/Base.astro';
import Section from '../components/blocks/Section.astro';
import Eyebrow from '../components/blocks/Eyebrow.astro';
import PageHeader from '../components/blocks/PageHeader.astro';
import StatBlock from '../components/blocks/StatBlock.astro';
import TrinityBand from '../components/blocks/TrinityBand.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Testimonios from '../components/blocks/Testimonios.astro';
import PhotoPlaceholder from '../components/ui/PhotoPlaceholder.astro';
import { foto } from '../lib/foto';

/* Sin página de equipo: el profesorado va cambiando y publicar
   nombres que se quedan viejos es peor que no publicarlos. Sí hay
   fotos generales: fachada, aula y grupo — no caducan como los nombres. */
const galeria = [
  { nombre: 'quienes-fachada.jpg', medidas: '1600×900 px · 16:9', alt: 'Fachada de Academia Educana en el Edificio Galileo' },
  { nombre: 'quienes-aula.jpg', medidas: '1200×800 px · 3:2', alt: 'Aula de Academia Educana con alumnos en clase' },
  { nombre: 'quienes-equipo.jpg', medidas: '1200×800 px · 3:2', alt: 'Equipo de profesores de Academia Educana' },
];
---
<Base
  title="Quiénes somos · Academia Educana"
  description="Academia Educana lleva más de 20 años en Sevilla Este, con grupos reducidos e instalaciones climatizadas. Centro examinador oficial de Trinity."
>
  <PageHeader
    migas={[{ label: 'Quiénes somos' }]}
    eyebrow="La academia"
    titulo="Veinte años en la misma esquina de Sevilla Este."
    tituloClass="max-w-[18ch]"
    amplia
  >
    <p class="text-(length:--text-lead) leading-relaxed text-cream/80 max-w-[60ch]">
      Nuestro centro en Sevilla Este surge de la necesidad que tiene el alumnado de un
      apoyo continuo. Por aquí han pasado más de 6.700 estudiantes y el objetivo sigue
      siendo el mismo: que resuelvan sus dificultades y aprueben los exámenes.
    </p>
  </PageHeader>

  <Section tone="paper">
    <div class="grid gap-5 sm:grid-cols-3">
      {galeria.map((g) => {
        const src = foto(g.nombre);
        return src
          ? <img src={src} alt={g.alt} width="600" height="400" loading="lazy" class="rounded-card aspect-3/2 w-full object-cover" />
          : <PhotoPlaceholder nombre={g.nombre} medidas={g.medidas} class="rounded-card aspect-3/2" />;
      })}
    </div>
  </Section>

  <Section tone="paper">
    <StatBlock stats={[
      { n: '20+', label: 'años en el mismo barrio', accent: true, icon: 'anios' },
      { n: '6.796', label: 'alumnos han pasado por Educana', icon: 'alumnos' },
      { n: '4', label: 'exámenes oficiales: Trinity, Cambridge, EOI y APTIS', icon: 'examenes' },
      { n: '0 €', label: 'de matrícula, en todos los cursos', accent: true, icon: 'gratis' },
    ]} />
  </Section>

  <Section tone="cream">
    <Eyebrow>Cómo trabajamos</Eyebrow>
    <h2 class="text-(length:--text-h2)">Tres cosas que no negociamos.</h2>
    <div class="grid gap-6 md:grid-cols-3">
      <Card class="gap-3 p-6">
        <h3 class="text-(length:--text-h3)">Grupos reducidos</h3>
        <p class="leading-relaxed text-slate">Es lo que permite que el profesor sepa el nombre de cada alumno y dónde falla cada uno. Las instalaciones están adaptadas y climatizadas, y los horarios se adaptan a lo que necesites.</p>
      </Card>
      <Card class="gap-3 p-6">
        <h3 class="text-(length:--text-h3)">Profesorado propio</h3>
        <p class="leading-relaxed text-slate">Una plantilla con gran experiencia, vocación y conocimiento del sistema educativo actual. Conocen los distintos centros de la zona y cómo examina cada uno.</p>
      </Card>
      <Card class="gap-3 p-6">
        <h3 class="text-(length:--text-h3)">Se dice la verdad</h3>
        <p class="leading-relaxed text-slate">Si con el tiempo que queda no da para aprobar, lo decimos antes de cobrar. Preferimos perder una matrícula que quedar mal en el barrio.</p>
      </Card>
    </div>
  </Section>

  <TrinityBand />

  <Section tone="cream">
    <Testimonios />
  </Section>

  <Section tone="rojo">
    <div class="flex flex-wrap items-center gap-6">
      <div class="flex-1 min-w-[18rem] flex flex-col gap-3">
        <h2 class="text-(length:--text-h2)">¿Te ayudamos?</h2>
        <p class="text-[1.05rem] leading-relaxed text-white/90">Pásate por la academia o llámanos. Sin compromiso.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href="/contacto/" icon="info" variant="blanco">Pide información</Button>
        <Button href="tel:+34954409696" icon="telefono" variant="blanco-azul" class="tabular">954 40 96 96</Button>
      </div>
    </div>
  </Section>
</Base>
