---
import { getCollection, render } from 'astro:content';
import Icon from '../components/ui/Icon.astro';
import Base from '../layouts/Base.astro';
import Section from '../components/blocks/Section.astro';
import Eyebrow from '../components/blocks/Eyebrow.astro';
import PageHeader from '../components/blocks/PageHeader.astro';
import LeadForm from '../components/blocks/LeadForm.astro';
import Faq from '../components/ui/Faq.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';

export async function getStaticPaths() {
  const cursos = await getCollection('cursos');
  return cursos.map((c) => ({ params: { slug: c.id }, props: { curso: c } }));
}

const { curso } = Astro.props;
const d = curso.data;
const { Content } = await render(curso);

const todos = await getCollection('cursos');
const relacionados = d.relacionados
  .map((r: string) => todos.find((c) => c.id === r))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const migas = { estudios: 'Estudios', accesos: 'Pruebas de acceso', ingles: 'Inglés' }[d.categoria];

/* Course + hasCourseInstance con fechas reales es lo que permite que
   Google muestre la convocatoria en el propio resultado (doc 05 §4). */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: d.h1,
  description: d.entradilla,
  provider: { '@id': `${Astro.site}#organization` },
  inLanguage: 'es',
  hasCourseInstance: [{
    '@type': 'CourseInstance',
    courseMode: 'onsite',
    location: { '@id': `${Astro.site}#organization` },
    courseSchedule: { '@type': 'Schedule', repeatFrequency: 'Weekly', description: d.datos.dias },
  }],
};
---
<Base title={d.metaTitulo} description={d.metaDescripcion} schema={schema}>
  <PageHeader
    migas={[{ label: migas }, { label: d.titulo }]}
    eyebrow={migas}
    titulo={d.h1}
    beneficios={[d.datos.duracion, d.datos.dias, d.datos.grupo, d.datos.desde, d.datos.convocatoria]}
  >
    <p class="text-(length:--text-lead) leading-relaxed text-cream/80 max-w-[58ch]">{d.entradilla}</p>
    <div class="flex flex-wrap gap-3">
      <Button href="/contacto/" icon="info" variant="rojo-aro">Pide información</Button>
      <Button href="tel:+34954409696" icon="telefono" variant="trans-claro" class="tabular">954 40 96 96</Button>
    </div>
  </PageHeader>

  <div class="bg-cream py-14 md:py-20">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_340px]">
      <div class="flex flex-col gap-14">
        <div class="flex flex-col gap-6">
          <Eyebrow>Qué incluye</Eyebrow>
          <h2 class="text-(length:--text-h2)">Qué incluye el curso</h2>
          <div class="grid gap-5 sm:grid-cols-2">
            {d.incluye.map((i: { titulo: string; texto: string }) => (
              <Card class="gap-2 p-5">
                <h3 class="text-base font-semibold">{i.titulo}</h3>
                <p class="text-[0.92rem] leading-relaxed text-slate">{i.texto}</p>
              </Card>
            ))}
          </div>
        </div>

        <div class="prose-educana flex flex-col gap-4"><Content /></div>

        <div class="flex flex-col gap-6">
          <Eyebrow>Dudas frecuentes</Eyebrow>
          <h2 class="text-(length:--text-h2)">Lo que más nos preguntáis</h2>
          <Faq items={d.faq} />
        </div>
      </div>

      <aside class="flex flex-col gap-5 lg:sticky lg:top-6 lg:self-start">
        <Card class="gap-4 p-6">
          <h2 class="text-(length:--text-h3)">Pide información</h2>
          <p class="text-[0.92rem] leading-relaxed text-slate">Te decimos plazas, horario y precio.</p>
          <LeadForm context={curso.id} compact={true} />
        </Card>
        {relacionados.length > 0 && (
          <Card class="gap-3 p-6">
            <Eyebrow>También te puede servir</Eyebrow>
            <ul class="flex flex-col gap-2">
              {relacionados.map((r) => (
                <li><a href={`/${r.id}/`} class="group inline-flex items-center gap-1.5 text-[0.95rem] hover:text-brand-ink">{r.data.titulo} <Icon name="flecha-larga" size="sm" class="transition-transform group-hover:translate-x-1" /></a></li>
              ))}
            </ul>
          </Card>
        )}
      </aside>
    </div>
  </div>

  <Section tone="rojo">
    <div class="flex flex-wrap items-center gap-6">
      <div class="flex-1 min-w-[18rem] flex flex-col gap-3">
        <h2 class="text-(length:--text-h2)">¿Te ayudamos a decidir?</h2>
        <p class="text-[1.05rem] leading-relaxed text-white/90">Llámanos y en cinco minutos sabes si este curso te encaja.</p>
      </div>
      <div class="flex flex-wrap gap-3">
      {/* Aquí el fondo YA es el rojo de marca: un botón rojo encima
          se funde con él (1,0:1). El relleno blanco es lo que separa,
          y el segundo botón va transparente. */}
        <Button href="/contacto/" icon="info" variant="blanco">Pide información</Button>
        <Button href="tel:+34954409696" icon="telefono" variant="trans-claro" class="tabular">954 40 96 96</Button>
      </div>
    </div>
  </Section>
</Base>

<style is:global>
  .prose-educana h2 { font-size: var(--text-h2); margin-block: 0.5rem 0.25rem; }
  .prose-educana h3 { font-size: var(--text-h3); margin-block: 0.5rem 0; }
  .prose-educana p { line-height: 1.7; color: var(--color-slate); max-width: 68ch; }
  .prose-educana ul { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.1rem; list-style: disc; color: var(--color-slate); }
  .prose-educana a { color: var(--color-brand-ink); text-decoration: underline; }
</style>
