---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/blocks/Section.astro';
import Eyebrow from '../components/blocks/Eyebrow.astro';
import DataBox from '../components/blocks/DataBox.astro';
import LeadForm from '../components/blocks/LeadForm.astro';
import Faq from '../components/ui/Faq.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import PhotoPlaceholder from '../components/ui/PhotoPlaceholder.astro';
import { foto } from '../lib/foto';

export async function getStaticPaths() {
  const cursos = await getCollection('cursos');
  return cursos.map((c) => ({ params: { slug: c.id }, props: { curso: c } }));
}

const { curso } = Astro.props;
const d = curso.data;
const { Content } = await render(curso);

const todos = await getCollection('cursos');
const relacionados = d.relacionados
  .map((r: string) => todos.find((c) => c.id === r))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const migas = { estudios: 'Estudios', accesos: 'Pruebas de acceso', ingles: 'Inglés' }[d.categoria];

// Convención de nombre: public/fotos/cursos/<slug>.jpg
const fotoNombre = `cursos/${curso.id}.jpg`;
const fotoSrc = foto(fotoNombre);

/* Course + hasCourseInstance con fechas reales es lo que permite que
   Google muestre la convocatoria en el propio resultado (doc 05 §4). */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: d.h1,
  description: d.entradilla,
  provider: { '@id': `${Astro.site}#organization` },
  inLanguage: 'es',
  hasCourseInstance: [{
    '@type': 'CourseInstance',
    courseMode: 'onsite',
    location: { '@id': `${Astro.site}#organization` },
    courseSchedule: { '@type': 'Schedule', repeatFrequency: 'Weekly', description: d.datos.dias },
  }],
};
---
<Base title={d.metaTitulo} description={d.metaDescripcion} schema={schema}>
  <section class="bg-cream pt-8 pb-12 md:pt-10 md:pb-16">
    <div class="container-page flex flex-col gap-7">
      <nav aria-label="Migas de pan" class="text-[0.78rem] text-slate">
        <a href="/" class="hover:text-ink">Inicio</a> <span aria-hidden="true">→</span> {migas} <span aria-hidden="true">→</span> <span class="text-ink">{d.titulo}</span>
      </nav>
      <div class="grid items-start gap-10 md:grid-cols-[1.1fr_0.9fr]">
        <div class="flex flex-col gap-5">
          <Eyebrow>{migas}</Eyebrow>
          <h1 class="text-(length:--text-h1)">{d.h1}</h1>
          <p class="text-(length:--text-lead) leading-relaxed text-slate max-w-[58ch]">{d.entradilla}</p>
        </div>
        {fotoSrc
          ? <img src={fotoSrc} alt="" width="720" height="480" loading="eager" class="rounded-card aspect-3/2 w-full object-cover" />
          : <PhotoPlaceholder nombre={fotoNombre} medidas="1200×800 px · proporción 3:2" class="rounded-card aspect-3/2" />}
      </div>
    </div>
  </section>

  <Section tone="paper">
    <DataBox items={[
      { k: 'Duración', v: d.datos.duracion },
      { k: 'Días y horas', v: d.datos.dias },
      { k: 'Grupo', v: d.datos.grupo },
      { k: 'Desde', v: d.datos.desde },
      { k: 'Próxima convocatoria', v: d.datos.convocatoria },
    ]} />
  </Section>

  <div class="bg-cream py-14 md:py-20">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_340px]">
      <div class="flex flex-col gap-14">
        <div class="flex flex-col gap-6">
          <Eyebrow>Qué incluye</Eyebrow>
          <h2 class="text-(length:--text-h2)">Qué incluye el curso</h2>
          <div class="grid gap-5 sm:grid-cols-2">
            {d.incluye.map((i: { titulo: string; texto: string }) => (
              <Card class="gap-2 p-5">
                <h3 class="text-base font-semibold">{i.titulo}</h3>
                <p class="text-[0.92rem] leading-relaxed text-slate">{i.texto}</p>
              </Card>
            ))}
          </div>
        </div>

        <div class="prose-educana flex flex-col gap-4"><Content /></div>

        <div class="flex flex-col gap-6">
          <Eyebrow>Dudas frecuentes</Eyebrow>
          <h2 class="text-(length:--text-h2)">Lo que más nos preguntáis</h2>
          <Faq items={d.faq} />
        </div>
      </div>

      <aside class="flex flex-col gap-5 lg:sticky lg:top-6 lg:self-start">
        <Card class="gap-4 p-6">
          <h2 class="text-(length:--text-h3)">Pide información</h2>
          <p class="text-[0.92rem] leading-relaxed text-slate">Te decimos plazas, horario y precio.</p>
          <LeadForm context={curso.id} compact={true} />
        </Card>
        {relacionados.length > 0 && (
          <Card class="gap-3 p-6">
            <Eyebrow>También te puede servir</Eyebrow>
            <ul class="flex flex-col gap-2">
              {relacionados.map((r) => (
                <li><a href={`/${r.id}/`} class="text-[0.95rem] hover:text-brand-ink">{r.data.titulo} →</a></li>
              ))}
            </ul>
          </Card>
        )}
      </aside>
    </div>
  </div>

  <Section tone="paper">
    <div class="flex flex-wrap items-center gap-6">
      <div class="flex-1 min-w-[18rem] flex flex-col gap-3">
        <h2 class="text-(length:--text-h2)">¿Te cuadra? Hablamos.</h2>
        <p class="leading-relaxed text-slate">Llámanos y en cinco minutos sabes si te encaja.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href="/contacto/">Pide información</Button>
        <Button href="tel:+34954409696" variant="outline">Llamar 954 40 96 96</Button>
      </div>
    </div>
  </Section>
</Base>

<style is:global>
  .prose-educana h2 { font-size: var(--text-h2); margin-block: 0.5rem 0.25rem; }
  .prose-educana h3 { font-size: var(--text-h3); margin-block: 0.5rem 0; }
  .prose-educana p { line-height: 1.7; color: var(--color-slate); max-width: 68ch; }
  .prose-educana ul { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.1rem; list-style: disc; color: var(--color-slate); }
  .prose-educana a { color: var(--color-brand-ink); text-decoration: underline; }
</style>
