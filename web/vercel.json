{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/preparacion-selectividad-sevilla/",
      "destination": "/curso-selectividad-sevilla-pevau/",
      "permanent": true
    },
    {
      "source": "/pruebas-acceso-universidad/",
      "destination": "/acceso-universidad-mayores-25/",
      "permanent": true
    },
    {
      "source": "/horarios-2/",
      "destination": "/horarios-cursos/",
      "permanent": true
    },
    {
      "source": "/educaline.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tienda/",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/carrito/",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/finalizar-compra/",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/mi-cuenta/",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/mi-perfil/",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/producto/reserva/",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/reserva-clases/",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/alumno/:path*",
      "destination": "/contacto/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
