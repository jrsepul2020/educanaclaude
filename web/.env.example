# Copiar a .env y rellenar. .env NO se versiona.

# Analítica. Sin este valor no se carga nada de GA4 ni aparece el banner.
PUBLIC_GA4_ID=

# Envío de formularios (Resend). Sin clave, el endpoint responde 503
# y el formulario muestra un aviso con el teléfono.
RESEND_API_KEY=
EMAIL_DESTINO=secretaria@academiaeducana.com
EMAIL_REMITENTE=web@academiaeducana.com
